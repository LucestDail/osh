# /etc/osh.env — systemd EnvironmentFile for osh.service
# gateway 설정 추가 시 기존 키를 지우지 말고 이 파일 전체를 merge 하세요.

# === AI Gateway (Gemini는 gateway가 보관) ===
GEMINI_API_URL=http://127.0.0.1:8780/gemini/v1beta/models/gemini-2.5-flash-lite:generateContent
AI_GATEWAY_TOKEN=
GEMINI_GATEWAY_SERVICE_ID=osh

# === 외부 API (대시보드 필수) ===
# 에어코리아: OSH는「시도별 실시간 측정」API 사용 (data.go.kr 15073861)
#   ArpltnInforInqireSvc/getCtprvnRltmMesureDnsty
# 공공데이터 포털 Decoding 키를 넣으세요 (코드에서 URL 인코딩함).
OPENWEATHER_API_KEY=
ITS_TRAFFIC_API_KEY=
SAFETY_EMERGENCY_API_KEY=
SAFETY_NEWS_API_KEY=
AIRKOREA_API_KEY=

# === DB (필요 시) ===
# DB_PASSWORD=
# NEWS_DB_PASSWORD=
